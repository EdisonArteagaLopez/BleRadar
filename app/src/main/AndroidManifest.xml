<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      FEATURE BLE:
      - Diz ao sistema que o app usa Bluetooth Low Energy.
      - android:required="true" impede instalação em devices sem BLE. Apenas para didática.
    -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!--
      PERMISSÕES ANDROID 12+ (API 31+):
      - A partir do Android 12, Bluetooth tem permissões "próprias".
      - BLUETOOTH_SCAN: permite fazer varredura (scan).
      - BLUETOOTH_CONNECT: permite acessar informações/conectar.
      - usesPermissionFlags="neverForLocation": declara que o scan não é para localização.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />



    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BleRadar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>